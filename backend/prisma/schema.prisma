  @@index([to_unit_id], map: "fk_unit_conversions_to_uom")
}

model units_of_measure {
  id                                                               BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  company_id                                                       BigInt             @db.UnsignedBigInt
  code                                                             String             @db.VarChar(20)
  name                                                             String             @db.VarChar(80)
  symbol                                                           String             @db.VarChar(20)
  unit_type                                                        String             @db.VarChar(40)
  is_base_unit                                                     Boolean            @default(false)
  created_at                                                       DateTime           @default(now()) @db.DateTime(0)
  updated_at                                                       DateTime           @default(now()) @db.DateTime(0)
  deleted_at                                                       DateTime?          @db.DateTime(0)
  products                                                         products[]
  unit_conversions_unit_conversions_from_unit_idTounits_of_measure unit_conversions[] @relation("unit_conversions_from_unit_idTounits_of_measure")
  unit_conversions_unit_conversions_to_unit_idTounits_of_measure   unit_conversions[] @relation("unit_conversions_to_unit_idTounits_of_measure")
  companies                                                        companies          @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_uom_company")

  @@unique([company_id, code], map: "uk_uom_company_code")
  @@index([company_id, unit_type], map: "idx_uom_company_type")
}

model user_roles {
  user_id     BigInt   @db.UnsignedBigInt
  role_id     BigInt   @db.UnsignedBigInt
  assigned_at DateTime @default(now()) @db.DateTime(0)
  assigned_by BigInt?  @db.UnsignedBigInt
  roles       roles    @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_roles_role")
  users       users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_roles_user")

  @@id([user_id, role_id])
  @@index([role_id], map: "fk_user_roles_role")
}

model user_sessions {
  id                 BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  company_id         BigInt    @db.UnsignedBigInt
  user_id            BigInt    @db.UnsignedBigInt
  terminal_id        BigInt?   @db.UnsignedBigInt
  device_fingerprint String?   @db.VarChar(180)
  ip_address         String?   @db.VarChar(64)
  user_agent         String?   @db.VarChar(255)
  login_at           DateTime  @default(now()) @db.DateTime(0)
  logout_at          DateTime? @db.DateTime(0)
  is_active          Boolean   @default(true)
  created_at         DateTime  @default(now()) @db.DateTime(0)
  updated_at         DateTime  @default(now()) @db.DateTime(0)
  companies          companies @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_sessions_company")
  users              users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_sessions_user")

  @@index([user_id], map: "fk_user_sessions_user")
  @@index([company_id, user_id, is_active], map: "idx_user_sessions_company_user_active")
  @@index([login_at], map: "idx_user_sessions_login")
}

model users {
  id            BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  company_id    BigInt          @db.UnsignedBigInt
  full_name     String          @db.VarChar(160)
  email         String          @db.VarChar(160)
  password_hash String          @db.VarChar(255)
  is_active     Boolean         @default(true)
  last_login_at DateTime?       @db.DateTime(0)
  created_at    DateTime        @default(now()) @db.DateTime(0)
  updated_at    DateTime        @default(now()) @db.DateTime(0)
  deleted_at    DateTime?       @db.DateTime(0)
  created_by    BigInt?         @db.UnsignedBigInt
  cash_closings cash_closings[]
  cash_openings cash_openings[]
  user_roles    user_roles[]
  user_sessions user_sessions[]
  companies     companies       @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_users_company")

  @@unique([company_id, email], map: "uk_users_company_email")
  @@index([company_id, is_active], map: "idx_users_company_active")
}

model warehouses {
  id                                                                       BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  company_id                                                               BigInt                @db.UnsignedBigInt
  code                                                                     String                @db.VarChar(40)
  name                                                                     String                @db.VarChar(140)
  address_line                                                             String?               @db.VarChar(220)
  commune_id                                                               BigInt?               @db.UnsignedBigInt
  is_main                                                                  Boolean               @default(false)
  is_active                                                                Boolean               @default(true)
  created_at                                                               DateTime              @default(now()) @db.DateTime(0)
  updated_at                                                               DateTime              @default(now()) @db.DateTime(0)
  deleted_at                                                               DateTime?             @db.DateTime(0)
  document_details                                                         document_details[]
  documents                                                                documents[]
  inventory                                                                inventory[]
  inventory_movements_inventory_movements_related_warehouse_idTowarehouses inventory_movements[] @relation("inventory_movements_related_warehouse_idTowarehouses")
  inventory_movements_inventory_movements_warehouse_idTowarehouses         inventory_movements[] @relation("inventory_movements_warehouse_idTowarehouses")
  pos_terminals                                                            pos_terminals[]
  sale_details                                                             sale_details[]
  communes                                                                 communes?             @relation(fields: [commune_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_warehouses_commune")
  companies                                                                companies             @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_warehouses_company")

  @@unique([company_id, code], map: "uk_warehouses_company_code")
  @@index([commune_id], map: "fk_warehouses_commune")
  @@index([company_id, is_active], map: "idx_warehouses_company_active")
}

