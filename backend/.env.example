# =============================================================================
# INTEGRA360 — Plantilla de variables de entorno
# =============================================================================
# Instrucciones:
#   1. Copiar este archivo como .env en la raíz del proyecto backend.
#   2. Rellenar todos los valores marcados con <CAMBIAR>.
#   3. Nunca incluir .env en control de versiones.
#   4. Caracteres especiales en contraseñas deben codificarse en URL:
#        #  →  %23  |  $  →  %24  |  @  →  %40  |  !  →  %21
# =============================================================================


# -----------------------------------------------------------------------------
# ENTORNO DE EJECUCIÓN
# -----------------------------------------------------------------------------
# Controla el comportamiento de logs, errores detallados y optimizaciones.
# Valores: development | test | production
NODE_ENV=development


# -----------------------------------------------------------------------------
# SERVIDOR HTTP
# -----------------------------------------------------------------------------
# Puerto en el que escucha la API REST.
PORT=3000

# Prefijo global de todas las rutas de la API.
API_PREFIX=/api

# Versión actual de la API. Usada en documentación y headers.
API_VERSION=v1


# -----------------------------------------------------------------------------
# BASE DE DATOS — MySQL 8+
# -----------------------------------------------------------------------------
# URL de conexión para Prisma ORM.
# Formato: mysql://USUARIO:PASSWORD@HOST:PUERTO/BASE_DE_DATOS
# Recuerda codificar en URL los caracteres especiales de la contraseña.
DATABASE_URL=mysql://root:<PASSWORD>@localhost:3306/integra360

# Número máximo de conexiones simultáneas al pool de la BD.
DATABASE_POOL_SIZE=10

# Tiempo máximo (ms) para adquirir una conexión del pool antes de error.
DATABASE_CONNECTION_TIMEOUT=30000


# -----------------------------------------------------------------------------
# AUTENTICACIÓN — JSON Web Tokens
# -----------------------------------------------------------------------------
# Clave secreta para firmar y verificar tokens JWT.
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<CAMBIAR_POR_CLAVE_ALEATORIA_64_CHARS>

# Duración del access token. Formato: número + unidad (s, m, h, d).
JWT_EXPIRES_IN=1d

# Duración del refresh token.
JWT_REFRESH_EXPIRES_IN=7d


# -----------------------------------------------------------------------------
# CORS — Control de origen cruzado
# -----------------------------------------------------------------------------
# URL del frontend autorizado para consumir la API.
FRONTEND_URL=http://localhost:5173


# -----------------------------------------------------------------------------
# RATE LIMITING — Protección contra abuso y DDoS
# -----------------------------------------------------------------------------
# Ventana de tiempo (ms). 60000 = 1 minuto.
RATE_LIMIT_WINDOW_MS=60000

# Peticiones máximas por IP dentro de la ventana.
RATE_LIMIT_MAX=100


# -----------------------------------------------------------------------------
# LOCALIZACIÓN — Chile
# -----------------------------------------------------------------------------
# Zona horaria del proceso Node.js. Recomendado: UTC para persistencia consistente.
TZ=UTC

# Zona horaria de sesión que la API intentará fijar al conectarse a MySQL.
# Recomendado: +00:00 para almacenar timestamps en UTC.
DB_SESSION_TIME_ZONE=+00:00

# Código de idioma y región (BCP 47).
APP_LOCALE=es-CL

# Moneda (ISO 4217). CLP = Peso Chileno.
APP_CURRENCY=CLP

# Separador decimal para valores numéricos.
APP_DECIMAL_SEPARATOR=,

# Separador de miles para valores numéricos.
APP_THOUSANDS_SEPARATOR=.

# Formato de fecha para reportes y UI.
APP_DATE_FORMAT=DD/MM/YYYY


# -----------------------------------------------------------------------------
# LOGGING — Pino
# -----------------------------------------------------------------------------
# Nivel mínimo de log. En producción usar: info
# Valores: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# Formato de salida. pretty para desarrollo, json para producción.
LOG_FORMAT=pretty


# -----------------------------------------------------------------------------
# ARCHIVOS Y ALMACENAMIENTO
# -----------------------------------------------------------------------------
# Tamaño máximo de uploads. Ejemplo: 5mb
UPLOAD_MAX_SIZE=5mb

# Directorio local de archivos subidos.
UPLOAD_DIR=./uploads
